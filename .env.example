# Copy to .env. Never commit actual credentials.
PORT=3000
HOST=127.0.0.1
# Configure both to enable browser Basic authentication (HTTPS for public use).
CYBERSEA_AUTH_USER=
CYBERSEA_AUTH_PASSWORD=
# Optional absolute directory; defaults to app/data.
CYBERSEA_DATA_DIR=

# Optional speech recognition endpoint
SENSEVOICE_URL=http://127.0.0.1:50000/api/v1/asr
# Optional Web Push: supply your own VAPID key pair and contact
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
# Set to 1 to disable background schedulers (e.g. local UI demos)
CYBERSEA_DISABLE_SCHEDULERS=0
