  {
    "name": "annotate_diary",
    "description": "在用户的日记上添加批画标记（红圈/波浪线/双横线/单横线），可附带批注文字。",
    "parameters": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "日记日期，格式YYYY-MM-DD"
        },
        "selected_text": {
          "type": "string",
          "description": "要标记的原文片段，必须和日记中出现的文本完全一致"
        },
        "mark_type": {
          "type": "string",
          "enum": [
            "circle",
            "wavy",
            "double_line",
            "single_line"
          ],
          "description": "标记类型：circle=红圈, wavy=波浪线, double_line=双横线, single_line=单横线"
        },
        "note": {
          "type": "string",
          "description": "批注文字，可选。写你想对这段话的评语或感受。"
        }
      },
      "required": [
        "date",
        "selected_text",
        "mark_type"
      ]
    }
  },
  {
    "name": "send_red_packet",
    "description": "给用户发一个红包。从虚拟钱包中扣除相应金额。红包金额5-100元为宜。余额不足时无法发送。",
    "parameters": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "description": "红包金额（元）"
        }
      },
      "required": [
        "amount"
      ]
    }
  },
  {
    "name": "send_gift",
    "description": "给用户送一份礼物。从你的虚拟钱包中扣除礼物金额。礼物价格要合理，一般50-200元。余额不足时无法发送。",
    "parameters": {
      "type": "object",
      "properties": {
        "item_name": {
          "type": "string",
          "description": "礼物名称，如\"一束玫瑰花\"、\"一个手工音乐盒\""
        },
        "amount": {
          "type": "number",
          "description": "礼物价格（元）"
        }
      },
      "required": [
        "item_name",
        "amount"
      ]
    }
  },
  {
    "name": "send_food_delivery",
    "description": "给用户点一份外卖。从你的虚拟钱包中扣除相应金额。外卖价格要符合实际（奶茶10-30元、简餐20-50元）。余额不足时无法发送。",
    "parameters": {
      "type": "object",
      "properties": {
        "item_name": {
          "type": "string",
          "description": "菜品名称，如\"一杯珍珠奶茶\"、\"一份鳗鱼饭\""
        },
        "amount": {
          "type": "number",
          "description": "外卖价格（元）"
        }
      },
      "required": [
        "item_name",
        "amount"
      ]
    }
  },
  {
    "name": "update_home_description",
    "description": "更新\"家\"的基本情况描述。家的描述应该是自然语言，列出家中的物品、布局、氛围等，用于生成环境描写。",
    "parameters": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "更新后的家描述全文（会完全替换旧内容），用自然语言描述家中的物品、布局和氛围"
        }
      },
      "required": [
        "description"
      ]
    }
  }
]
